    <!-- JavaScript for Role Switching -->
    <script>
        // Get elements
        const roleStudent = document.getElementById('role_student');
        const roleEmployer = document.getElementById('role_employer');
        const roleInput = document.getElementById('role_input');

        // Function to update hidden input value
        function updateRole() {
            if (roleStudent && roleStudent.checked) {
                roleInput.value = 'student';
            } else if (roleEmployer && roleEmployer.checked) {
                roleInput.value = 'employer';
            }
        }

        // Add event listeners if elements exist
        if (roleStudent) roleStudent.addEventListener('change', updateRole);
        if (roleEmployer) roleEmployer.addEventListener('change', updateRole);

        // Initialize on page load
        updateRole();
    </script>

