    <!-- JavaScript for Skills Management -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Add Skill
            document.getElementById('addSkillBtn').addEventListener('click', function() {
                const skillId = document.getElementById('skillSelect').value;
                const proficiency = document.getElementById('proficiencyLevel').value;

                if (!skillId || !proficiency) {
                    alert('Please select both skill and proficiency level');
                    return;
                }

                fetch('dashboard.php', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `ajax_action=add_skill&skill_id=${skillId}&proficiency=${proficiency}`
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            location.reload(); // Reload to show new skill
                        } else {
                            alert('Error: ' + (data.error || 'Failed to add skill'));
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Failed to add skill');
                    });
            });

            // Remove Skill
            document.querySelectorAll('.remove-skill-btn').forEach(button => {
                button.addEventListener('click', function() {
                    if (!confirm('Are you sure you want to remove this skill?')) {
                        return;
                    }

                    const skillId = this.dataset.skillId;

                    fetch('dashboard.php', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: `ajax_action=remove_skill&skill_id=${skillId}`
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                location.reload(); // Reload to update skills list
                            } else {
                                alert('Error: ' + (data.error || 'Failed to remove skill'));
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Failed to remove skill');
                        });
                });
            });

            // Remove Shortlisted Placement
            document.querySelectorAll('.remove-shortlist-btn').forEach(button => {
                button.addEventListener('click', function () {

                    if (!confirm('Are you sure you want to remove this placement from your shortlist?')) {
                        return;
                    }

                    const placementId = this.dataset.placementId;

                    fetch('dashboard.php', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: `ajax_action=remove_shortlisted&placement_id=${placementId}`
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                location.reload(); // Refresh shortlist section
                            } else {
                                alert('Error: ' + (data.error || 'Failed to remove shortlisted placement'));
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Failed to remove shortlisted placement');
                        });

                });
            });

            // Toggle hide/show matched applications (student dashboard)
            const toggleStudentMatchedBtn = document.querySelector('.toggle-matched-student-btn');
            if (toggleStudentMatchedBtn) {
                let showMatched = true; // currently showing matched

                toggleStudentMatchedBtn.addEventListener('click', function () {
                    showMatched = !showMatched;
                    this.textContent = showMatched ? 'Hide Matched' : 'Show Matched';

                    document.querySelectorAll('.student-application-card').forEach(card => {
                        const status = card.dataset.status;
                        const isMatched = (status === 'interested'); // "interested" = confirmed match

                        if (isMatched) {
                            card.style.display = showMatched ? '' : 'none';
                        }
                    });
                });
            }

        });
    </script>

