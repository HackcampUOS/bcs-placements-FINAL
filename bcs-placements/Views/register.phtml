    <!-- JavaScript for Role Switching -->
    <script>
        // Get elements
        const roleStudent = document.getElementById('role_student');
        const roleEmployer = document.getElementById('role_employer');
        const roleInput = document.getElementById('role_input');
        const studentFields = document.getElementById('student_fields');
        const employerFields = document.getElementById('employer_fields');

        // Function to toggle fields based on role
        function toggleFields() {
            if (roleStudent.checked) {
                roleInput.value = 'student';
                studentFields.style.display = 'block';
                employerFields.style.display = 'none';

                // Make student fields required
                document.getElementById('first_name').required = true;
                document.getElementById('last_name').required = true;
                document.getElementById('company_name').required = false;
                document.getElementById('contact_name').required = false;
            } else if (roleEmployer.checked) {
                roleInput.value = 'employer';
                studentFields.style.display = 'none';
                employerFields.style.display = 'block';

                // Make employer fields required
                document.getElementById('first_name').required = false;
                document.getElementById('last_name').required = false;
                document.getElementById('company_name').required = true;
                document.getElementById('contact_name').required = true;
            }
        }

        // Add event listeners
        roleStudent.addEventListener('change', toggleFields);
        roleEmployer.addEventListener('change', toggleFields);

        // Initialize on page load
        toggleFields();
    </script>

