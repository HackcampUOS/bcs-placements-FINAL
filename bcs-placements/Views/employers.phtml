<script>
    document.addEventListener('DOMContentLoaded', function () {
        const toggleEmployerMatchedBtn = document.querySelector('.toggle-matched-employer-btn');
        if (toggleEmployerMatchedBtn) {
            let showMatched = true; // currently showing matched

            toggleEmployerMatchedBtn.addEventListener('click', function () {
                showMatched = !showMatched;
                this.textContent = showMatched ? 'Hide Matched' : 'Show Matched';

                document.querySelectorAll('.employer-application-card').forEach(card => {
                    const status = card.dataset.status;
                    const isMatched = (status === 'interested'); // same convention

                    if (isMatched) {
                        card.style.display = showMatched ? '' : 'none';
                    }
                });
            });
        }
    });
</script>

