    <!-- JavaScript for Bookmark Toggle (AJAX) -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const shortlistButtons = document.querySelectorAll('.shortlist-btn');

            // Initialize all popovers
            document.querySelectorAll('[data-bs-toggle="popover"]').forEach(el => {
                new bootstrap.Popover(el);
            });

            shortlistButtons.forEach(button => {
                // Hover effect for bookmarked items
                button.addEventListener('mouseenter', function() {
                    if (this.dataset.shortlisted === 'true') {
                        const checkIcon = this.querySelector('.bi-bookmark-check-fill');
                        const dashIcon = this.querySelector('.bi-bookmark-dash');
                        if (checkIcon && dashIcon) {
                            checkIcon.classList.add('d-none');
                            dashIcon.classList.remove('d-none');
                        }
                    }
                });

                button.addEventListener('mouseleave', function() {
                    if (this.dataset.shortlisted === 'true') {
                        const checkIcon = this.querySelector('.bi-bookmark-check-fill');
                        const dashIcon = this.querySelector('.bi-bookmark-dash');
                        if (checkIcon && dashIcon) {
                            checkIcon.classList.remove('d-none');
                            dashIcon.classList.add('d-none');
                        }
                    }
                });

                // Auto-hide popover after 2 seconds
                button.addEventListener('click', function () {
                    setTimeout(() => {
                        const instance = bootstrap.Popover.getInstance(button);
                        if (instance) instance.hide();
                    }, 5000);
                });

                // Click handler
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    const placementId = this.dataset.placementId;
                    const isShortlisted = this.dataset.shortlisted === 'true';
                    const action = isShortlisted ? 'remove' : 'add';

                    // Send AJAX request
                    fetch('placements.php', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: `toggle_shortlist=1&placement_id=${placementId}&action=${action}`
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                // Toggle button appearance
                                if (data.action === 'added') {
                                    this.innerHTML = `
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-bookmark-check-fill bookmark-icon text-success" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M2 15.5V2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.74.439L8 13.069l-5.26 2.87A.5.5 0 0 1 2 15.5m8.854-9.646a.5.5 0 0 0-.708-.708L7.5 7.793 6.354 6.646a.5.5 0 1 0-.708.708l1.5 1.5a.5.5 0 0 0 .708 0z"/>
                            </svg>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-bookmark-dash bookmark-hover-icon text-danger d-none" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M2 15.5V2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.74.439L8 13.069l-5.26 2.87A.5.5 0 0 1 2 15.5M6 6a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1z"/>
                            </svg>
                        `;
                                    this.dataset.shortlisted = 'true';
                                } else {
                                    this.innerHTML = `
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-bookmark-plus bookmark-icon text-primary" viewBox="0 0 16 16">
                                <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.777.416L8 13.101l-5.223 2.815A.5.5 0 0 1 2 15.5zm2-1a1 1 0 0 0-1 1v12.566l4.723-2.482a.5.5 0 0 1 .554 0L13 14.566V2a1 1 0 0 0-1-1z"/>
                                <path d="M8 4a.5.5 0 0 1 .5.5V6H10a.5.5 0 0 1 0 1H8.5v1.5a.5.5 0 0 1-1 0V7H6a.5.5 0 0 1 0-1h1.5V4.5A.5.5 0 0 1 8 4"/>
                            </svg>
                        `;
                                    this.dataset.shortlisted = 'false';
                                }
                            }
                        })
                        .catch(error => console.error('Error:', error));
                });
            });
        });
    </script>

